# ==========================================
# RTLign Project .gitignore
# ==========================================

# 1. Cloud Data Folder (CRITICAL)
# Put all your downloaded Drive data here
data/*
!data/README.md
!data/*.parquet
!data/**/*.parquet
datasets/

# 2. OpenROAD & EDA Outputs
*.def
*.lef
*.odb
*.sdc
*.spef
*.gds
*.mac
*.rpt
*.log
*.err
openroad_scripts/results/
openroad_scripts/reports/

# 3. Verilog Simulation & Synthesis
*.hex
*.vcd
*.fsdb
*.out
csrc/
simv
simv.daidir/

# 4. Python & ML Predictor
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.conda/
*.pth    # PyTorch model weights
*.pkl    # Scikit-Learn models

# 5. OS Generated Files
.DS_Store
Thumbs.db

# 6. Local Synthesis Tools & Temp Scripts
oss-cad-suite/
merge_lefs.py
temp.tcl
openroad_debug.log
.ua/
.pytest_cache/
.hypothesis/
.venv/

# 7. Reports
*Report*.md